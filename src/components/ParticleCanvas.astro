---
// Fundo animado "hacker" com múltiplos estilos de partículas:
// rede, matrix, estrelas e nebulosa. Script inline clássico (não é módulo).
// O botão no canto roda os estilos; a escolha fica salva em localStorage.
---

<canvas class="particle-canvas" id="particle-canvas" aria-hidden="true"></canvas>
<button
	class="particle-mode"
	id="particle-mode"
	type="button"
	aria-label="Trocar estilo de partículas"
>
	<span id="particle-mode-label">rede</span>
</button>

<script is:inline>
	(function () {
		'use strict';
		var canvas = document.getElementById('particle-canvas');
		if (!canvas) {
			console.warn('particle-canvas nao encontrado');
			return;
		}
		var ctx = canvas.getContext('2d');
		if (!ctx) {
			console.warn('canvas 2d indisponivel');
			return;
		}
		console.log('particle-canvas iniciado');

		var W = 0,
			H = 0,
			t = 0;
		var mx = -1e4,
			my = -1e4;

		var MODES = ['rede', 'matrix', 'estrelas', 'nebulosa'];
		var MODE_LABEL = { rede: 'rede', matrix: 'matrix', estrelas: 'estrelas', nebulosa: 'nebulosa' };
		var LINK = 140,
			MOUSE_R = 200;

		var btn = document.getElementById('particle-mode');
		var label = document.getElementById('particle-mode-label');
		var stored = null;
		try {
			stored = localStorage.getItem('particles');
		} catch (e) {}
		var mode = MODES.indexOf(stored) > -1 ? stored : 'rede';

		function readAccent() {
			var v =
				getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
			if (!/^#/.test(v)) v = '#ffffff';
			var h = v.replace('#', '');
			if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
			var n = parseInt(h, 16);
			return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
		}
		var RGB = readAccent();
		function rgba(a) {
			return 'rgba(' + RGB[0] + ',' + RGB[1] + ',' + RGB[2] + ',' + a + ')';
		}

		/* ---------------- estado por modo ---------------- */
		var parts = []; // rede
		var trail = []; // rede
		var cols = []; // matrix
		var stars = []; // estrelas
		var blobs = []; // nebulosa
		var MATRIX_CHARS = '0123456789ABCDEF$#=+-<>*░▒▓█';
		var COL_W = 16;

		function initRede() {
			parts = [];
			var n = Math.max(30, Math.min(110, Math.round((W * H) / 18000)));
			for (var i = 0; i < n; i++) {
				parts.push({
					x: Math.random() * W,
					y: Math.random() * H,
					vx: (Math.random() - 0.5) * 0.6,
					vy: (Math.random() - 0.5) * 0.6,
					r: i < n / 8 ? 1.6 + Math.random() * 1.6 : 0.7 + Math.random() * 1.2,
					hub: i < n / 8,
				});
			}
		}

		function initMatrix() {
			cols = [];
			var n = Math.ceil(W / COL_W) + 1;
			for (var i = 0; i < n; i++) {
				cols.push({
					x: (Math.random() * W) | 0,
					y: (Math.random() * H) | 0,
					sp: 1.2 + Math.random() * 2.6,
					ch: MATRIX_CHARS[(Math.random() * MATRIX_CHARS.length) | 0],
				});
			}
		}

		function initStars() {
			stars = [];
			var n = Math.round((W * H) / 14000);
			for (var i = 0; i < n; i++) {
				stars.push({
					x: Math.random() * W,
					y: Math.random() * H,
					r: 0.5 + Math.random() * 1.6,
					vx: (Math.random() - 0.5) * 0.25,
					vy: 0.08 + Math.random() * 0.5,
					ph: Math.random() * Math.PI * 2,
					big: Math.random() < 0.12,
				});
			}
		}

		function initNebulosa() {
			blobs = [];
			var n = Math.max(16, Math.round((W * H) / 52000));
			for (var i = 0; i < n; i++) {
				blobs.push({
					x: Math.random() * W,
					y: Math.random() * H,
					r: 30 + Math.random() * 90,
					sx: (Math.random() - 0.5) * 0.35,
					sy: (Math.random() - 0.5) * 0.35,
					ph: Math.random() * Math.PI * 2,
				});
			}
		}

		function applyMode(m) {
			mode = m;
			label.textContent = MODE_LABEL[m] || m;
			if (m === 'rede') initRede();
			if (m === 'matrix') initMatrix();
			if (m === 'estrelas') initStars();
			if (m === 'nebulosa') initNebulosa();
		}

		function resize() {
			W = window.innerWidth;
			H = window.innerHeight;
			var dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			applyMode(mode);
		}

		/* ---------------- renders por modo ---------------- */
		function drawRede() {
			for (var i = 0; i < parts.length; i++) {
				var p = parts[i];
				p.x += p.vx;
				p.y += p.vy;
				if (p.x < 0 || p.x > W) p.vx *= -1;
				if (p.y < 0 || p.y > H) p.vy *= -1;
				p.x = Math.max(0, Math.min(W, p.x));
				p.y = Math.max(0, Math.min(H, p.y));
				if (mx > -9000 && my > -9000) {
					var dx = mx - p.x,
						dy = my - p.y;
					var d2 = dx * dx + dy * dy;
					if (d2 < MOUSE_R * MOUSE_R && d2 > 1) {
						var d = Math.sqrt(d2);
						var f = (1 - d / MOUSE_R) * 0.1;
						p.vx += (dx / d) * f;
						p.vy += (dy / d) * f;
					}
				}
				p.vx *= 0.985;
				p.vy *= 0.985;
			}

			for (var j = trail.length - 1; j >= 0; j--) {
				trail[j][2] -= 0.05;
				if (trail[j][2] <= 0) trail.splice(j, 1);
			}

			ctx.clearRect(0, 0, W, H);

			ctx.lineWidth = 1;
			for (var a = 0; a < parts.length; a++) {
				for (var b = a + 1; b < parts.length; b++) {
					var xx = parts[a].x - parts[b].x,
						yy = parts[a].y - parts[b].y;
					var dd = xx * xx + yy * yy;
					if (dd < LINK * LINK) {
						var al = (1 - Math.sqrt(dd) / LINK) * 0.4;
						ctx.strokeStyle = rgba(al);
						ctx.beginPath();
						ctx.moveTo(parts[a].x, parts[a].y);
						ctx.lineTo(parts[b].x, parts[b].y);
						ctx.stroke();
					}
				}
			}

			if (mx > -9000 && my > -9000) {
				var g = ctx.createRadialGradient(mx, my, 0, mx, my, MOUSE_R);
				g.addColorStop(0, rgba(0.3));
				g.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = g;
				ctx.fillRect(mx - MOUSE_R, my - MOUSE_R, MOUSE_R * 2, MOUSE_R * 2);

				ctx.lineWidth = 1.5;
				for (var c = 0; c < parts.length; c++) {
					var q = parts[c];
					var qx = q.x - mx,
						qy = q.y - my;
					var qd2 = qx * qx + qy * qy;
					if (qd2 < MOUSE_R * MOUSE_R) {
						var qal = (1 - Math.sqrt(qd2) / MOUSE_R) * 0.5;
						ctx.strokeStyle = rgba(qal);
						ctx.beginPath();
						ctx.moveTo(mx, my);
						ctx.lineTo(q.x, q.y);
						ctx.stroke();
					}
				}

				for (var tt = 0; tt < trail.length; tt++) {
					ctx.fillStyle = rgba(trail[tt][2] * 0.6);
					ctx.beginPath();
					ctx.arc(trail[tt][0], trail[tt][1], 2.5 * trail[tt][2], 0, Math.PI * 2);
					ctx.fill();
				}

				var cg = ctx.createRadialGradient(mx, my, 0, mx, my, 10);
				cg.addColorStop(0, 'rgba(255,255,255,0.95)');
				cg.addColorStop(0.4, rgba(0.9));
				cg.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = cg;
				ctx.beginPath();
				ctx.arc(mx, my, 10, 0, Math.PI * 2);
				ctx.fill();
			}

			for (var d2n = 0; d2n < parts.length; d2n++) {
				var pp = parts[d2n];
				ctx.fillStyle = rgba(pp.hub ? 0.9 : 0.6);
				ctx.beginPath();
				ctx.arc(pp.x, pp.y, pp.r, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function drawMatrix() {
			ctx.clearRect(0, 0, W, H);
			ctx.font = '14px "JetBrains Mono Nerd Font", monospace';
			for (var i = 0; i < cols.length; i++) {
				var c = cols[i];
				for (var k = 0; k < 6; k++) {
					var yk = c.y - k * 15;
					if (yk < -15 || yk > H) continue;
					var alpha = 0.85 * (1 - k / 6);
					ctx.fillStyle = rgba(alpha);
					ctx.fillText(c.ch, c.x, yk);
				}
				c.y += c.sp;
				if (c.y > H + 60) {
					c.y = -20;
					c.x = (Math.random() * W) | 0;
				}
				if ((Math.random() < 0.02)) c.ch = MATRIX_CHARS[(Math.random() * MATRIX_CHARS.length) | 0];
			}
			if (mx > -9000 && my > -9000) {
				ctx.fillStyle = rgba(0.25);
				ctx.beginPath();
				ctx.arc(mx, my, 2, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function drawEstrelas() {
			ctx.clearRect(0, 0, W, H);
			for (var i = 0; i < stars.length; i++) {
				var s = stars[i];
				s.x += s.vx;
				s.y -= s.vy;
				if (mx > -9000 && my > -9000) {
					var dx = s.x - mx,
						dy = s.y - my;
					var d2 = dx * dx + dy * dy;
					if (d2 < 150 * 150 && d2 > 1) {
						var d = Math.sqrt(d2);
						var f = 0.18 * (1 - d / 150);
						s.x += (dx / d) * f;
						s.y += (dy / d) * f;
					}
				}
				if (s.x > W) s.x = 0;
				if (s.x < 0) s.x = W;
				if (s.y > H) s.y = 0;
				if (s.y < 0) s.y = H;
				var tw = 0.4 + 0.6 * Math.abs(Math.sin(t * 0.02 + s.ph));
				ctx.fillStyle = rgba(0.28 + 0.72 * tw);
				ctx.beginPath();
				ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
				ctx.fill();
				if (s.big) {
					ctx.fillStyle = rgba(0.06 * tw);
					ctx.beginPath();
					ctx.arc(s.x, s.y, s.r * 4, 0, Math.PI * 2);
					ctx.fill();
				}
			}
		}

		function drawNebulosa() {
			ctx.clearRect(0, 0, W, H);
			for (var i = 0; i < blobs.length; i++) {
				var b = blobs[i];
				if (mx > -9000 && my > -9000) {
					var dx = mx - b.x,
						dy = my - b.y;
					var d2 = dx * dx + dy * dy;
					if (d2 < (MOUSE_R * 1.6) * (MOUSE_R * 1.6)) {
						var d = Math.sqrt(d2) || 1;
						var f = 0.25 * (1 - d / (MOUSE_R * 1.6));
						b.x += (dx / d) * f;
						b.y += (dy / d) * f;
					}
				}
				b.x += b.sx;
				b.y += b.sy;
				if (b.x < -b.r) b.x = W + b.r;
				if (b.x > W + b.r) b.x = -b.r;
				if (b.y < -b.r) b.y = H + b.r;
				if (b.y > H + b.r) b.y = -b.r;

				var pulse = 0.55 + 0.45 * Math.sin(t * 0.008 + b.ph);
				var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * pulse);
				g.addColorStop(0, rgba(0.16));
				g.addColorStop(0.5, rgba(0.05));
				g.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = g;
				ctx.fillRect(b.x - b.r, b.y - b.r, b.r * 2, b.r * 2);
			}
		}

		function frame() {
			t++;
			if (mode === 'rede') drawRede();
			else if (mode === 'matrix') drawMatrix();
			else if (mode === 'estrelas') drawEstrelas();
			else drawNebulosa();
			requestAnimationFrame(frame);
		}

		/* ---------------- controles ---------------- */
		function cycle() {
			var idx = MODES.indexOf(mode);
			var next = MODES[(idx + 1) % MODES.length];
			applyMode(next);
			try {
				localStorage.setItem('particles', next);
			} catch (e) {}
		}
		btn.addEventListener('click', cycle);
		document.addEventListener('keydown', function (e) {
			if (e.key === 'm' || e.key === 'M') {
				var tag = (document.activeElement && document.activeElement.tagName) || '';
				if (tag !== 'INPUT' && tag !== 'TEXTAREA') cycle();
			}
		});

		function move(e) {
			mx = e.clientX || 0;
			my = e.clientY || 0;
			if (mode === 'rede') {
				trail.push([mx, my, 1]);
				if (trail.length > 28) trail.shift();
			}
		}
		function leave() {
			mx = -1e4;
			my = -1e4;
			trail.length = 0;
		}

		window.addEventListener('resize', resize);
		window.addEventListener('mousemove', move, { passive: true });
		window.addEventListener('pointermove', move, { passive: true });
		window.addEventListener(
			'touchmove',
			function (e) {
				if (e.touches[0]) move(e.touches[0]);
			},
			{ passive: true }
		);
		document.documentElement.addEventListener('mouseleave', leave);
		document.documentElement.addEventListener('pointerleave', leave);
		document.addEventListener('visibilitychange', function () {
			if (document.hidden) leave();
		});

		resize();
		applyMode(mode);
		requestAnimationFrame(frame);
	})();
</script>

<style>
	.particle-canvas {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.particle-mode {
		position: fixed;
		right: 1em;
		bottom: 1em;
		z-index: 40;
		padding: 0.35em 0.8em;
		border: 1px solid var(--border);
		border-radius: 2px;
		background: color-mix(in srgb, var(--page-bg) 78%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: rgb(var(--gray));
		font-family: var(--font-mono), 'Courier New', monospace;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: 0.2s ease;
	}
	.particle-mode:hover {
		color: rgb(var(--black));
		border-color: rgb(var(--gray));
	}
	.particle-mode::before {
		content: '[';
		margin-right: 0.35em;
	}
	.particle-mode::after {
		content: ']';
		margin-left: 0.35em;
	}
</style>