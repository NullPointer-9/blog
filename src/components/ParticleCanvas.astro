---
// Fundo animado estilo "Atomic": rede de partículas conectadas
// que reage ao movimento do mouse.
---

<canvas class="particle-canvas" aria-hidden="true"></canvas>

<script>
	(() => {
		const canvas = document.querySelector('.particle-canvas');
		const ctx = canvas.getContext('2d');
		const accent = getComputedStyle(document.documentElement)
			.getPropertyValue('--accent')
			.trim() || '#8b5cf6';

		const hexToRgb = (hex) => {
			const m = hex.replace('#', '');
			const full = m.length === 3 ? m.split('').map((c) => c + c).join('') : m;
			const n = parseInt(full, 16);
			return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
		};

		const [cr, cg, cb] = hexToRgb(accent);
		const LINK_DIST = 130;
		const MOUSE_RADIUS = 190;

		let w = 0,
			h = 0,
			raf = null,
			t = 0;
		let burst = 0;
		let particles = [];
		const mouse = { x: -9999, y: -9999 };
		const trail = [];

		const rand = (min, max) => min + Math.random() * (max - min);

		const makeParticles = () => {
			const area = w * h;
			const count = Math.min(120, Math.max(40, Math.round(area / 16000)));
			particles = Array.from({ length: count }, (_, i) => ({
				x: rand(0, w),
				y: rand(0, h),
				vx: rand(-0.25, 0.25),
				vy: rand(-0.25, 0.25),
				r: i < count / 8 ? rand(2.2, 3.2) : rand(0.6, 1.8),
				hub: i < count / 8,
			}));
		};

		const resize = () => {
			w = window.innerWidth;
			h = window.innerHeight;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(w * dpr);
			canvas.height = Math.round(h * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			makeParticles();
		};

		const step = () => {
			burst *= 0.9;
			for (let i = trail.length - 1; i >= 0; i--) {
				trail[i].life -= 0.045;
				if (trail[i].life <= 0) trail.splice(i, 1);
			}
			for (const p of particles) {
				p.x += p.vx;
				p.y += p.vy;
				if (p.x < 0 || p.x > w) p.vx *= -1;
				if (p.y < 0 || p.y > h) p.vy *= -1;
				p.x = Math.min(Math.max(p.x, 0), w);
				p.y = Math.min(Math.max(p.y, 0), h);
				if (mouse.x > -9000 && mouse.y > -9000) {
					const dx = mouse.x - p.x;
					const dy = mouse.y - p.y;
					const d2 = dx * dx + dy * dy;
					if (d2 < MOUSE_RADIUS * MOUSE_RADIUS && d2 > 0.01) {
						const d = Math.sqrt(d2);
						const boost = 1 + burst * 3;
						const f = (1 - d / MOUSE_RADIUS) * 0.12 * boost;
						p.vx += (dx / d) * f;
						p.vy += (dy / d) * f;
						const speed = Math.hypot(p.vx, p.vy);
						const max = 3 + burst * 5;
						if (speed > max) {
							p.vx = (p.vx / speed) * max;
							p.vy = (p.vy / speed) * max;
						}
					}
				}
			}
		};

		const draw = () => {
			ctx.clearRect(0, 0, w, h);

			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const a = particles[i];
					const b = particles[j];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const d2 = dx * dx + dy * dy;
					if (d2 < LINK_DIST * LINK_DIST) {
						const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * 0.28;
						ctx.strokeStyle = `rgba(${cr},${cg},${cb},${alpha})`;
						ctx.lineWidth = 1;
						ctx.beginPath();
						ctx.moveTo(a.x, a.y);
						ctx.lineTo(b.x, b.y);
						ctx.stroke();
					}
				}
			}

			if (mouse.x > -9000) {
				const pulse = (0.8 + 0.2 * Math.sin(t * 0.004)) * (1 + burst * 1.6);
				const R = MOUSE_RADIUS * (0.9 + 0.1 * Math.sin(t * 0.005) + burst * 0.8);
				const aura = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, R);
				aura.addColorStop(0, `rgba(${cr},${cg},${cb},${0.3 * pulse})`);
				aura.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = aura;
				ctx.fillRect(mouse.x - R, mouse.y - R, R * 2, R * 2);

				for (const p of particles) {
					const dx = p.x - mouse.x;
					const dy = p.y - mouse.y;
					const d2 = dx * dx + dy * dy;
					if (d2 < MOUSE_RADIUS * MOUSE_RADIUS) {
						const alpha = (1 - Math.sqrt(d2) / MOUSE_RADIUS) * 0.45;
						ctx.strokeStyle = `rgba(${cr},${cg},${cb},${alpha})`;
						ctx.lineWidth = 1.4;
						ctx.beginPath();
						ctx.moveTo(p.x, p.y);
						ctx.lineTo(mouse.x, mouse.y);
						ctx.stroke();
					}
				}

				for (const dot of trail) {
					ctx.fillStyle = `rgba(${cr},${cg},${cb},${dot.life * 0.5})`;
					ctx.beginPath();
					ctx.arc(dot.x, dot.y, 2.6 * dot.life, 0, Math.PI * 2);
					ctx.fill();
				}

				const core = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 8 + burst * 10);
				core.addColorStop(0, `rgba(255,255,255,${0.95})`);
				core.addColorStop(0.35, `rgba(${cr},${cg},${cb},0.9)`);
				core.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = core;
				ctx.beginPath();
				ctx.arc(mouse.x, mouse.y, 8 + burst * 10, 0, Math.PI * 2);
				ctx.fill();
			}

			for (const p of particles) {
				ctx.fillStyle = `rgba(${cr},${cg},${cb},${p.hub ? 0.85 : 0.55})`;
				if (p.hub) {
					ctx.shadowColor = `rgba(${cr},${cg},${cb},0.9)`;
					ctx.shadowBlur = 10;
				}
				ctx.beginPath();
				ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				ctx.fill();
				ctx.shadowBlur = 0;
			}
		};

		const frame = () => {
			t++;
			step();
			draw();
			raf = requestAnimationFrame(frame);
		};

		const onMove = (e) => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
			trail.push({ x: e.clientX, y: e.clientY, life: 1 });
			if (trail.length > 26) trail.splice(0, trail.length - 26);
		};
		const onDown = (e) => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
			burst = 1;
		};
		const onLeave = () => {
			mouse.x = -9999;
			mouse.y = -9999;
		};

		resize();
		window.addEventListener('resize', resize);
		window.addEventListener('pointermove', onMove, { passive: true });
		window.addEventListener('mousemove', onMove, { passive: true });
		window.addEventListener('pointerdown', onDown);
		window.addEventListener('touchstart', onDown, { passive: true });
		window.addEventListener(
			'touchmove',
			(e) => onMove(e.touches[0]),
			{ passive: true },
		);
		window.addEventListener('touchend', () => setTimeout(onLeave, 400), {
			passive: true,
		});
		document.documentElement.addEventListener('mouseleave', onLeave);
		document.documentElement.addEventListener('pointerleave', onLeave);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) onLeave();
		});
		frame();
	})();
</script>

<style>
	.particle-canvas {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>