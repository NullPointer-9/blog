---
import ThemeToggle from './ThemeToggle.astro';

const today = new Date();

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: import.meta.env.BASE_URL + '/';
---

<footer>
	<div class="links">
		<a href="https://github.com/NullPointer-9" target="_blank" rel="noopener">GitHub</a>
		<a href={`${base}rss.xml`}>RSS</a>
		<ThemeToggle />
	</div>
	<p>&copy; {today.getFullYear()} NullPointer-9. Todos os direitos reservados.</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		border-top: 1px solid var(--border);
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85rem;
	}
	.links {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-bottom: 0.75em;
	}
	.links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.links a:hover {
		color: rgb(var(--gray-dark));
	}
	footer :global(.theme-toggle) {
		margin-left: 0.25em;
	}
	p {
		margin: 0;
	}
</style>