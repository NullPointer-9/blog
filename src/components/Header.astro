---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: import.meta.env.BASE_URL + '/';
---

<header>
	<nav>
		<a class="brand" href={base}>NullPointer-9</a>
		<div class="links">
			<HeaderLink href={base}>Blog</HeaderLink>
			<HeaderLink href={`${base}about`}>Sobre</HeaderLink>
		</div>
		<ThemeToggle />
	</nav>
</header>
<style>
	header {
		padding: 0 1em;
		border-bottom: 1px solid var(--border);
		background: transparent;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
	}
	.brand {
		font-weight: 700;
		font-size: 1.05rem;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand:hover {
		color: var(--accent);
	}
	.links {
		display: flex;
		gap: 0.25em;
		margin-left: auto;
	}
	.links :global(a) {
		display: inline-block;
		padding: 0.9em 0.5em;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: 0.2s ease;
	}
	.links :global(a:hover) {
		color: rgb(var(--gray-dark));
	}
	.links :global(a.active) {
		color: rgb(var(--black));
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		.brand {
			font-size: 0.95rem;
		}
		.links :global(a) {
			padding: 0.9em 0.4em;
		}
	}
</style>