---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: import.meta.env.BASE_URL + '/';
---

<header id="nav">
	<nav>
		<a class="logo" href={base}>
			<span class="logo-box">
				<img src={`${base}favicon.svg`} alt="" width="26" height="26" />
			</span>
			<span class="logo-name">NullPointer-9</span>
		</a>
		<ul class="nav-links">
			<li>
				<HeaderLink href={base}>Blog</HeaderLink>
			</li>
			<li>
				<HeaderLink href={`${base}about`}>Sobre</HeaderLink>
			</li>
		</ul>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--page-bg) 82%, transparent);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		backdrop-filter: blur(24px) saturate(180%);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5em;
		width: 100%;
		margin: 0 auto;
		padding: 1em clamp(1em, 4vw, 3em);
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65em;
		text-decoration: none;
		color: rgb(var(--black));
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.logo-box {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 9px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, rgb(var(--glow)) 4%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, rgb(var(--glow)) 6%, transparent);
		transition:
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			box-shadow 0.25s ease;
	}
	.logo-box img {
		width: 70%;
		height: 70%;
		object-fit: contain;
		border-radius: 3px;
	}
	.logo:hover .logo-box {
		transform: rotate(45deg);
		box-shadow: 0 0 20px rgba(var(--glow), 0.22);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
		margin: 0 0 0 auto;
		padding: 0;
		list-style: none;
	}
	.nav-links :global(a) {
		position: relative;
		display: inline-block;
		padding: 0.55em 0.6em;
		color: rgb(var(--gray));
		font-size: 0.92rem;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.nav-links :global(a)::after {
		content: '';
		position: absolute;
		left: 0.6em;
		right: 0.6em;
		bottom: -1px;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.nav-links :global(a:hover) {
		color: rgb(var(--black));
	}
	.nav-links :global(a:hover)::after,
	.nav-links :global(a.active)::after {
		transform: scaleX(1);
	}
	.nav-links :global(a.active) {
		color: rgb(var(--black));
	}
	@media (max-width: 720px) {
		nav {
			padding: 0.8em 1em;
		}
		.logo-name {
			font-size: 0.95rem;
		}
		.nav-links :global(a) {
			font-size: 0.85rem;
			padding: 0.55em 0.4em;
		}
	}
	@media (max-width: 520px) {
		.logo-name {
			display: none;
		}
	}
</style>