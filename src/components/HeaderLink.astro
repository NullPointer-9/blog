---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const stripBase = (path) => path.replace(import.meta.env.BASE_URL, '');
const pathname = stripBase(Astro.url.pathname);
const hrefPath = stripBase(href);
const segment = pathname.match(/[^\/]+/g)?.[0] || '';
const isActive = hrefPath === pathname || hrefPath === '/' + segment;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
