---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: import.meta.env.BASE_URL + '/';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d: Date) =>
	d
		.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
		.toUpperCase()
		.replace(', ', '.')
		.replace(/ /g, '.');
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<ParticleCanvas />
		<Header />
		<main>
			<section class="bio">
				<img class="avatar" src={`${base}favicon.svg`} alt="" width="96" height="96" />
				<div class="intro">
					<h1 class="title text-gradient">NullPointer-9</h1>
					<p class="role">Desenvolvedor Web</p>
					<p class="tagline">{SITE_DESCRIPTION}</p>
<p class="term">
					<span class="cmd">$</span> echo &quot;olá, universo&quot;<span class="cursor">&#9608;</span>
				</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Posts recentes</h2>
				<ul class="posts">
					{
						posts.map((post) => (
							<li>
								<a href={`${base}${post.id}/`}>
									<time datetime={post.data.pubDate.toISOString()}>
										{fmtDate(post.data.pubDate)}
									</time>
									<span class="title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<p class="feed">
				<a href={`${base}rss.xml`}>Assinar RSS &rarr;</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		position: relative;
		width: 720px;
	}
	.bio {
		display: flex;
		align-items: center;
		gap: 1.75em;
		margin: 1.5em 0 3.5em;
		animation: fadeUp 0.7s ease both;
	}
	.avatar {
		width: 104px;
		height: 104px;
		flex-shrink: 0;
		border-radius: 50%;
		border: 1px solid var(--border);
		box-shadow: 0 0 0 1px var(--border), 0 0 32px rgba(var(--glow), 0.22);
	}
	.title {
		margin: 0 0 0.15em;
		font-size: 2.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.role {
		margin: 0 0 0.25em;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
	}
	.tagline {
		margin: 0 0 0.6em;
		color: rgb(var(--gray));
	}
	.term {
		margin: 0;
		display: inline-block;
		padding: 0.35em 0.9em;
		border: 1px solid var(--border);
		border-radius: 2px;
		background: color-mix(in srgb, var(--page-bg) 70%, transparent);
		font-family: var(--font-mono), 'Courier New', monospace;
		font-size: 0.82rem;
		color: rgb(var(--gray));
	}
	.term .cmd {
		color: var(--accent);
		font-weight: 700;
	}
	.term .cursor {
		display: inline-block;
		margin-left: 0.15em;
		color: var(--accent);
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.section-title {
		margin: 0 0 0.5em;
		font-size: 1.4rem;
	}
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.posts li {
		border-bottom: 1px solid var(--border);
	}
	.posts li:last-child {
		border-bottom: none;
	}
	.posts a {
		display: flex;
		align-items: baseline;
		gap: 1.5em;
		padding: 0.9em 0.3em;
		border-radius: 8px;
		text-decoration: none;
		color: rgb(var(--black));
		transition: 0.2s ease;
	}
	.posts a:hover {
		color: var(--accent);
		background: color-mix(in srgb, var(--glow) 7%, transparent);
		padding-left: 0.7em;
		box-shadow: 0 0 24px rgba(var(--glow), 0.1);
	}
	.posts time {
		flex-shrink: 0;
		width: 7.5em;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
	}
	.posts a:hover time {
		color: var(--accent);
	}
	.posts .title {
		font-size: 1.05rem;
		font-weight: 600;
	}
	.feed {
		margin-top: 2em;
	}
	.feed a {
		display: inline-block;
		padding: 0.5em 1.2em;
		border: 1px solid rgb(var(--gray));
		border-radius: 0;
		background: transparent;
		color: rgb(var(--black));
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		transition: 0.2s ease;
	}
	.feed a:hover {
		background: rgb(var(--black));
		color: var(--page-bg);
		box-shadow: 0 0 24px rgba(var(--glow), 0.25);
	}
	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (max-width: 720px) {
		.bio {
			flex-direction: column;
			text-align: center;
			gap: 1em;
		}
		.posts a {
			flex-direction: column;
			gap: 0.15em;
			padding: 1em 0.2em;
		}
	}
</style>